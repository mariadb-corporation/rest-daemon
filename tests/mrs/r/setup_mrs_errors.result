# mariadb-restd 'HOSTNAME:8443' configured for the MariaDB server at '127.0.0.1:PORT'

Start it with

    DIRECTORY/START_SCRIPT

or

    mariadb-restd -c DIRECTORY/mariadb-restd.conf

The MariaDB REST Service can then be reached at

    https://localhost:8443/<service>
select id, product_name from mariadb_rest_service.rest_daemon;
id	product_name
1	MariaDB REST Daemon
include/assert.inc [--force reuses the account of the existing deployment]
DROP USER setup_admin;
DROP SCHEMA mariadb_rest_service;
DROP ROLE mariadb_rest_service_admin;
DROP ROLE mariadb_rest_service_schema_admin;
DROP ROLE mariadb_rest_service_meta_provider;
DROP ROLE mariadb_rest_service_data_provider;
DROP ROLE mariadb_rest_service_dev;
