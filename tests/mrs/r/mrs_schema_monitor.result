# MySQL Rest Service schema created.
# MySQL Rest Service, server accounts configured.
# DB `basic_schema` - created
# Registred SERVICE at path: /svc
# Registred DB_SCHEMA at path: /svc/basic_schema
# Registred DB_OBJECT at path: /svc/basic_schema/tab1

I. Verify that the monitoring thread adds the router entry when it is missing in the metadata

DELETE from mariadb_rest_service.rest_daemon where id = '10000000-0000-7000-8000-000000000001';
SELECT id from mariadb_rest_service.rest_daemon where id = '10000000-0000-7000-8000-000000000001';
id
10000000-0000-7000-8000-000000000001

II. Verify that when the monitoring thread sees incompatible metadata version it stops the service and restores it when it becomes compatible again.

DROP view `mariadb_rest_service`.`msm_schema_version`;
CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER
VIEW `mariadb_rest_service`.`msm_schema_version`(`major`,`minor`,`patch`)
AS select 1 AS `1`,0 AS `0`,0 AS `0`;
DROP view `mariadb_rest_service`.`msm_schema_version`;
CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER
VIEW `mariadb_rest_service`.`msm_schema_version`(`major`,`minor`,`patch`)
AS select 5 AS `5`,0 AS `0`,0 AS `0`;

III. Verify that when the service_enabled flag is cleared in the metadata the mtr stops the service and restores it when it becomes enabled again.

update `mariadb_rest_service`.`config` set service_enabled = 0;
update `mariadb_rest_service`.`config` set service_enabled = 1;

IV. Verify that when the monitoring thread encounters invalid metadata (missing view) it stops the service and restores once it becomes available again

DROP view `mariadb_rest_service`.`msm_schema_version`;
CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY INVOKER
VIEW `mariadb_rest_service`.`msm_schema_version`(`major`,`minor`,`patch`)
AS select 5 AS `5`,0 AS `0`,0 AS `0`;

V. Verify that when there is a discrepancy in the audit_log table (index) the MRS still notices the changes in the metadata by doing a full refresh

# Registred DB_OBJECT at path: /svc/basic_schema/tab3
delete from `mariadb_rest_service`.`audit_log`;

VI. The daemon publishes its status variables in rest_daemon.attributes, in
the format the metadata's status downsampling reads

SELECT JSON_LENGTH(JSON_EXTRACT(attributes, '$.statusVariables')) AS entries,
JSON_CONTAINS(JSON_EXTRACT(attributes, '$.statusVariables'),
'{"name": "mariadbConnectionsActive", "column": "active_mariadb_connections", "nonResettable": true}') AS active,
JSON_CONTAINS(JSON_EXTRACT(attributes, '$.statusVariables'),
'{"name": "mariadbQueries", "column": "mariadb_queries"}') AS queries,
JSON_CONTAINS(JSON_EXTRACT(attributes, '$.statusVariables'),
'{"name": "restCachedItems", "nonResettable": true}') AS cached_items
FROM mariadb_rest_service.rest_daemon WHERE id = '10000000-0000-7000-8000-000000000001';
entries	active	queries	cached_items
43	1	1	1
CALL mariadb_rest_service.rest_daemon_status_do_cleanup(NOW());
SELECT COUNT(*) > 0 AS status_rows FROM mariadb_rest_service.rest_daemon_status;
status_rows
1
DROP SCHEMA basic_schema;
DROP SCHEMA mariadb_rest_service;
DROP ROLE mariadb_rest_service_admin;
DROP ROLE mariadb_rest_service_schema_admin;
DROP ROLE mariadb_rest_service_meta_provider;
DROP ROLE mariadb_rest_service_data_provider;
DROP ROLE mariadb_rest_service_dev;
