"========================"
"update content_set table"
truncate mariadb_rest_service.rest_daemon_status;
UPDATE `mariadb_rest_service`.`content_set` SET request_path = "/newpath";
stats
{"endpoints": "2", "items": "0", "files": "0", "itemLoads": 0, "itemEjects": 0, "itemHits": 0, "itemMisses": 0, "fileLoads": 0, "fileEjects": 0, "fileHits": 0, "fileMisses": 0}
UPDATE `mariadb_rest_service`.`content_set` SET request_path = "/static";
"FR5 - oldest entries in the cache must be expunged to fit when maxCacheSize reduced"
stats
{"endpoints": "2", "items": "0", "files": "0", "itemLoads": 0, "itemEjects": 0, "itemHits": 0, "itemMisses": 0, "fileLoads": 0, "fileEjects": 0, "fileHits": 0, "fileMisses": 0}
"cache file1, file2"
