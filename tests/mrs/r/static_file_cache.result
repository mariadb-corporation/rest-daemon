{"endpoints": "2", "items": "0", "files": "2", "itemLoads": 0, "itemEjects": 0, "itemHits": 0, "itemMisses": 0, "fileLoads": 2, "fileEjects": 0, "fileHits": 0, "fileMisses": 2}
