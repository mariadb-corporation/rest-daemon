# MySQL Rest Service schema created.
# MySQL Rest Service, server accounts configured.
# DB `basic_schema` - created
update mariadb_rest_service.config set data = json_merge_patch(data, '{"responseCache":{"maxCacheSize":200}, "fileCache":{"maxCacheSize":80}}');
# Registred SERVICE at path: /svc
# Registred CONTENT_SET at path: /svc/static
# Registred CONTENT_FILE at path: /svc/static/file1
# Registred CONTENT_FILE at path: /svc/static/file2
"FR1 - access files from cache"
"cache file1, file2"
TEST FILE 1 CONTENT
END OF FILE

TEST FILE 2 CONTENT
END OF FILE

stats
{"endpoints": "2", "items": "0", "files": "2", "itemLoads": 0, "itemEjects": 0, "itemHits": 0, "itemMisses": 0, "fileLoads": 2, "fileEjects": 0, "fileHits": 0, "fileMisses": 2}
"access files from cache"
TEST FILE 1 CONTENT
END OF FILE

TEST FILE 2 CONTENT
END OF FILE

stats
{"endpoints": "2", "items": "0", "files": "2", "itemLoads": 0, "itemEjects": 0, "itemHits": 0, "itemMisses": 0, "fileLoads": 0, "fileEjects": 0, "fileHits": 2, "fileMisses": 0}
truncate mariadb_rest_service.rest_daemon_status;
# restart
"FR4 - the cache must be reset when the content_set table changes"
"update content_set table"
"cache file1, file2"
TEST FILE 1 CONTENT
END OF FILE

TEST FILE 2 CONTENT
END OF FILE

