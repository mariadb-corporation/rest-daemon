    "cbit1": false,
    "cblob": "",
    "cdate": "2020-12-01",
    "cenum": "value1",
    "ctext": "numeric zeros",
    "ctime": "12:01:50.000000",
    "cyear": 2020,
    "links": [
        {
            "rel": "self",
            "href": "/svc/basic_schema/tab/1"
