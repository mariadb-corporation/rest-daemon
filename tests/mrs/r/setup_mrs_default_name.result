# MySQL Rest Service schema created.
CREATE USER mrs_setup_user IDENTIFIED BY 'pass';
GRANT SELECT, INSERT, UPDATE on mysql_rest_service_metadata.* to mrs_setup_user;
GRANT mysql_rest_service_data_provider TO mrs_setup_user WITH ADMIN OPTION;
GRANT CREATE USER ON *.* TO mrs_setup_user WITH GRANT OPTION;
GRANT mysql_rest_service_meta_provider TO mrs_setup_user WITH ADMIN OPTION;
# Setting up mariadb-mrsd in 'DIRECTORY'

- Checking the MRS metadata
- Registering the instance in the MRS metadata
- Creating the MRS account(s) if needed
- Creating a self-signed TLS certificate for the HTTPS server
- Storing the account password(s) and the JWT secret in the keyring
- Creating configuration DIRECTORY/mariadb-mrsd.conf

# mariadb-mrsd 'HOSTNAME:8443' configured for the MySQL server at '127.0.0.1:PORT'

Start it with

    DIRECTORY/START_SCRIPT

or

    mariadb-mrsd -c DIRECTORY/mariadb-mrsd.conf

The MySQL REST Service can then be reached at

    https://localhost:8443/<service>
# File automatically generated by mariadb-mrsd --setup
[DEFAULT]
logging_folder=DIRECTORY_FILE_OR_FOLDER
runtime_folder=DIRECTORY_FILE_OR_FOLDER
data_folder=DIRECTORY_FILE_OR_FOLDER
keyring_path=DIRECTORY_FILE_OR_FOLDER
master_key_path=DIRECTORY_FILE_OR_FOLDER
unknown_config_option=error
plugin_folder=ROUTER_PLUGIN_DIRECTORY

[logger]
level=info

[http_server]
port=8443
ssl=1
ssl_cert=DIRECTORY_FILE_OR_FOLDER
ssl_key=DIRECTORY_FILE_OR_FOLDER

[mysql_rest_service]
mysql_read_write_destinations=ADDR:PORT
mysql_user=mariadb_mrsd1_RANDOM
router_id=1

select id, product_name, options from mysql_rest_service_metadata.router;
id	product_name	options
1	MariaDB REST Service Daemon	{}
select router_name from mysql_rest_service_metadata.router;
router_name
"Name found"
select attributes from mysql_rest_service_metadata.router;
attributes
{"mrs_metadata_accounts": ["mariadb_mrsd1_RANDOM"]}
select user, host from mysql.user where user like 'mariadb_mrsd1_%';
user	host
mariadb_mrsd1_RANDOM	%
select from_user, to_user from mysql.role_edges where to_user like 'mariadb_mrsd1_%' order by from_user;
from_user	to_user
mysql_rest_service_data_provider	mariadb_mrsd1_RANDOM
mysql_rest_service_meta_provider	mariadb_mrsd1_RANDOM
DROP USER 'mrs_setup_user'@'%';
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
