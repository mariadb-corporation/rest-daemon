# MySQL Rest Service schema created.
CREATE USER mrs_setup_user IDENTIFIED BY 'pass';
GRANT SELECT, INSERT, UPDATE on mariadb_rest_service.* to mrs_setup_user;
GRANT mariadb_rest_service_data_provider TO mrs_setup_user WITH ADMIN OPTION;
GRANT CREATE USER ON *.* TO mrs_setup_user WITH GRANT OPTION;
GRANT mariadb_rest_service_meta_provider TO mrs_setup_user WITH ADMIN OPTION;
# Setting up mariadb-restd in 'DIRECTORY'

- Checking the REST metadata
- Registering the instance in the REST metadata
- Creating the REST service account(s) if needed
- Creating a self-signed TLS certificate for the HTTPS server
- Storing the account password(s) and the JWT secret in the keyring
- Creating configuration DIRECTORY/mariadb-restd.conf

# mariadb-restd 'HOSTNAME:8443' configured for the MariaDB server at '127.0.0.1:PORT'

Start it with

    DIRECTORY/START_SCRIPT

or

    mariadb-restd -c DIRECTORY/mariadb-restd.conf

The MariaDB REST Service can then be reached at

    https://localhost:8443/<service>
# File automatically generated by mariadb-restd --setup
[DEFAULT]
logging_folder=DIRECTORY_FILE_OR_FOLDER
runtime_folder=DIRECTORY_FILE_OR_FOLDER
data_folder=DIRECTORY_FILE_OR_FOLDER
keyring_path=DIRECTORY_FILE_OR_FOLDER
master_key_path=DIRECTORY_FILE_OR_FOLDER
unknown_config_option=error
plugin_folder=ROUTER_PLUGIN_DIRECTORY

[logger]
level=info

[http_server]
port=8443
ssl=1
ssl_cert=DIRECTORY_FILE_OR_FOLDER
ssl_key=DIRECTORY_FILE_OR_FOLDER

[mariadb_rest_service]
read_write_destinations=ADDR:PORT
metadata_user=mariadb_restd_RANDOM
rest_daemon_id=UUID

select id, product_name, options from mariadb_rest_service.rest_daemon;
id	product_name	options
UUID	MariaDB REST Daemon	{}
select name from mariadb_rest_service.rest_daemon;
name
"Name found"
select attributes from mariadb_rest_service.rest_daemon;
attributes
{"mrs_metadata_accounts": ["mariadb_restd_RANDOM"]}
select user AS user, host AS host from mysql.user where user like 'mariadb_restd_%';
user	host
mariadb_restd_RANDOM	%
SELECT Role AS from_user, User AS to_user FROM mysql.roles_mapping WHERE User LIKE 'mariadb_restd_%' ORDER BY Role;
from_user	to_user
mariadb_rest_service_data_provider	mariadb_restd_RANDOM
mariadb_rest_service_meta_provider	mariadb_restd_RANDOM
DROP USER 'mrs_setup_user'@'%';
DROP SCHEMA mariadb_rest_service;
DROP ROLE mariadb_rest_service_admin;
DROP ROLE mariadb_rest_service_schema_admin;
DROP ROLE mariadb_rest_service_meta_provider;
DROP ROLE mariadb_rest_service_data_provider;
DROP ROLE mariadb_rest_service_dev;
