{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mariadb-restd",
  "builtin-baseline": "98d7375b79be7551ac3db6fbe668a08da9b1cac5",
  "dependencies": [
    {
      "name": "libmariadb",
      "features": [
        "openssl"
      ]
    },
    "openssl"
  ],
  "features": {
