# MY_CHECK_CXX_COMPILER_WARNING("-Wfoo" OUTVAR)
# If the compiler knows -Wfoo, set OUTVAR to "-Wno-foo" (used to silence it).
FUNCTION(MY_CHECK_CXX_COMPILER_WARNING WARNING_OPTION OUTVAR)
  STRING(REGEX REPLACE "^-?W?" "" _warning "${WARNING_OPTION}")
  STRING(MAKE_C_IDENTIFIER "HAVE_CXX_W_${_warning}" _cachevar)
  IF(MSVC)
    SET(${OUTVAR} "" PARENT_SCOPE)
    RETURN()
  ENDIF()
  CHECK_CXX_COMPILER_FLAG("-W${_warning}" ${_cachevar})
  IF(${_cachevar})
    SET(${OUTVAR} "-Wno-${_warning}" PARENT_SCOPE)
  ELSE()
    SET(${OUTVAR} "" PARENT_SCOPE)
  ENDIF()
ENDFUNCTION()

# ADD_COMPILE_FLAGS(<files> COMPILE_FLAGS <flags>)
FUNCTION(ADD_COMPILE_FLAGS)
  SET(FILES "")
  SET(FLAGS "")
  SET(_seen)
  FOREACH(ARG ${ARGV})
    IF(ARG STREQUAL "COMPILE_FLAGS")
      SET(_seen 1)
    ELSEIF(_seen)
      LIST(APPEND FLAGS ${ARG})
    ELSE()
      LIST(APPEND FILES ${ARG})
    ENDIF()
  ENDFOREACH()
  FOREACH(FILE ${FILES})
    SET_PROPERTY(SOURCE ${FILE} APPEND PROPERTY COMPILE_OPTIONS ${FLAGS})
  ENDFOREACH()
ENDFUNCTION()

# ---------------------------------------------------------------------------
# library / executable helpers (server: cmake/libutils.cmake,
# cmake/mysql_add_executable.cmake)
# ---------------------------------------------------------------------------
SET(_LIB_MULTI_KW
  COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES INCLUDE_DIRECTORIES
  SYSTEM_INCLUDE_DIRECTORIES LINK_LIBRARIES DEPENDENCIES)

# apply the keyword arguments shared by all library helpers;
# DEFAULT_SCOPE is used when the argument list doesn't start with a scope
MACRO(_MRSD_APPLY_TARGET_ARGS TARGET DEFAULT_SCOPE)
  IF(ARG_COMPILE_DEFINITIONS)
    _MRSD_SCOPED(TARGET_COMPILE_DEFINITIONS ${TARGET} ${DEFAULT_SCOPE}
      ${ARG_COMPILE_DEFINITIONS})
  ENDIF()
  IF(ARG_COMPILE_OPTIONS)
    _MRSD_SCOPED(TARGET_COMPILE_OPTIONS ${TARGET} ${DEFAULT_SCOPE}
      ${ARG_COMPILE_OPTIONS})
  ENDIF()
  IF(ARG_COMPILE_FEATURES)
    _MRSD_SCOPED(TARGET_COMPILE_FEATURES ${TARGET} PUBLIC
      ${ARG_COMPILE_FEATURES})
  ENDIF()
  IF(ARG_INCLUDE_DIRECTORIES)
    _MRSD_SCOPED(TARGET_INCLUDE_DIRECTORIES ${TARGET} ${DEFAULT_SCOPE}
      ${ARG_INCLUDE_DIRECTORIES})
  ENDIF()
  IF(ARG_SYSTEM_INCLUDE_DIRECTORIES)
    TARGET_INCLUDE_DIRECTORIES(${TARGET} SYSTEM PRIVATE
      ${ARG_SYSTEM_INCLUDE_DIRECTORIES})
  ENDIF()
  IF(ARG_LINK_LIBRARIES)
    TARGET_LINK_LIBRARIES(${TARGET} ${ARG_LINK_LIBRARIES})
  ENDIF()
  IF(ARG_DEPENDENCIES)
    ADD_DEPENDENCIES(${TARGET} ${ARG_DEPENDENCIES})
  ENDIF()
ENDMACRO()

# call CMD(TARGET [scope] args...), adding DEFAULT_SCOPE if the args don't
# start with PUBLIC/PRIVATE/INTERFACE
FUNCTION(_MRSD_SCOPED CMD TARGET DEFAULT_SCOPE)
  SET(_args ${ARGN})
  LIST(GET _args 0 _first)
  IF(NOT _first MATCHES "^(PUBLIC|PRIVATE|INTERFACE)$")
    LIST(PREPEND _args ${DEFAULT_SCOPE})
  ENDIF()
  CMAKE_LANGUAGE(CALL ${CMD} ${TARGET} ${_args})
ENDFUNCTION()

FUNCTION(ADD_STATIC_LIBRARY TARGET)
  CMAKE_PARSE_ARGUMENTS(ARG "EXCLUDE_FROM_ALL;EXCLUDE_FROM_PGO" ""
    "${_LIB_MULTI_KW}" ${ARGN})
  ADD_LIBRARY(${TARGET} STATIC)
  TARGET_SOURCES(${TARGET} PRIVATE ${ARG_UNPARSED_ARGUMENTS})
  TARGET_COMPILE_FEATURES(${TARGET} PUBLIC cxx_std_20)
  IF(ARG_EXCLUDE_FROM_ALL)
    SET_PROPERTY(TARGET ${TARGET} PROPERTY EXCLUDE_FROM_ALL TRUE)
  ENDIF()
  _MRSD_APPLY_TARGET_ARGS(${TARGET} PRIVATE)
ENDFUNCTION()

MACRO(ADD_CONVENIENCE_LIBRARY TARGET_ARG)
  ADD_STATIC_LIBRARY(${TARGET_ARG} ${ARGN})
  SET_PROPERTY(TARGET ${TARGET_ARG} PROPERTY POSITION_INDEPENDENT_CODE ON)
ENDMACRO()

FUNCTION(ADD_SHARED_LIBRARY TARGET)
  CMAKE_PARSE_ARGUMENTS(ARG
    "EXCLUDE_FROM_ALL;EXCLUDE_FROM_PGO;NO_UNDEFINED;SKIP_INSTALL;NAMELINK_SKIP"
    "COMPONENT;DESTINATION;LINUX_VERSION_SCRIPT;OUTPUT_NAME;SOVERSION;VERSION;WIN_DEF_FILE"
    "${_LIB_MULTI_KW}" ${ARGN})
  ADD_LIBRARY(${TARGET} SHARED ${ARG_UNPARSED_ARGUMENTS})
  TARGET_COMPILE_FEATURES(${TARGET} PUBLIC cxx_std_20)
  IF(ARG_EXCLUDE_FROM_ALL)
    SET_PROPERTY(TARGET ${TARGET} PROPERTY EXCLUDE_FROM_ALL TRUE)
  ENDIF()
  _MRSD_APPLY_TARGET_ARGS(${TARGET} PRIVATE)
  IF(ARG_OUTPUT_NAME)
    SET_TARGET_PROPERTIES(${TARGET} PROPERTIES OUTPUT_NAME "${ARG_OUTPUT_NAME}")
  ENDIF()
  IF(ARG_SOVERSION)
    SET_TARGET_PROPERTIES(${TARGET} PROPERTIES SOVERSION "${ARG_SOVERSION}")
  ENDIF()
  IF(ARG_VERSION)
    SET_TARGET_PROPERTIES(${TARGET} PROPERTIES VERSION "${ARG_VERSION}")
  ENDIF()
  IF(LINUX AND ARG_LINUX_VERSION_SCRIPT)
    TARGET_LINK_OPTIONS(${TARGET} PRIVATE
      LINKER:--version-script=${ARG_LINUX_VERSION_SCRIPT})
  ENDIF()
  IF(NOT ARG_SKIP_INSTALL)
    IF(ARG_DESTINATION)
      SET(_dest "${ARG_DESTINATION}")
    ELSEIF(WIN32)
      SET(_dest "${INSTALL_BINDIR}")
    ELSE()
      SET(_dest "${INSTALL_LIBDIR}")
    ENDIF()
    SET(_comp Router)
    IF(ARG_COMPONENT)
      SET(_comp ${ARG_COMPONENT})
    ENDIF()
    SET(_namelink)
    IF(ARG_NAMELINK_SKIP)
      SET(_namelink NAMELINK_SKIP)
    ENDIF()
    INSTALL(TARGETS ${TARGET}
      RUNTIME DESTINATION ${_dest} COMPONENT ${_comp}
      LIBRARY DESTINATION ${_dest} COMPONENT ${_comp} ${_namelink})
  ENDIF()
ENDFUNCTION()

FUNCTION(MYSQL_ADD_EXECUTABLE TARGET)
  CMAKE_PARSE_ARGUMENTS(ARG
    "ENABLE_EXPORTS;EXCLUDE_FROM_ALL;EXCLUDE_FROM_GCOV;EXCLUDE_FROM_PGO;SKIP_INSTALL;SKIP_TCMALLOC"
    "ADD_GCOV_TEST;ADD_TEST;COMPONENT;DESTINATION;RUNTIME_OUTPUT_DIRECTORY"
    "COMPILE_DEFINITIONS;COMPILE_OPTIONS;DEPENDENCIES;INCLUDE_DIRECTORIES;SYSTEM_INCLUDE_DIRECTORIES;LINK_LIBRARIES;LINK_OPTIONS"
    ${ARGN})
  ADD_EXECUTABLE(${TARGET} ${ARG_UNPARSED_ARGUMENTS})
  TARGET_COMPILE_FEATURES(${TARGET} PUBLIC cxx_std_20)
  IF(ARG_EXCLUDE_FROM_ALL)
    SET_PROPERTY(TARGET ${TARGET} PROPERTY EXCLUDE_FROM_ALL TRUE)
  ENDIF()
  IF(ARG_RUNTIME_OUTPUT_DIRECTORY)
    SET_TARGET_PROPERTIES(${TARGET} PROPERTIES
      RUNTIME_OUTPUT_DIRECTORY ${ARG_RUNTIME_OUTPUT_DIRECTORY})
  ENDIF()
  IF(ARG_ENABLE_EXPORTS AND LINUX)
    SET_TARGET_PROPERTIES(${TARGET} PROPERTIES ENABLE_EXPORTS TRUE)
  ENDIF()
  _MRSD_APPLY_TARGET_ARGS(${TARGET} PRIVATE)
  IF(ARG_LINK_OPTIONS)
    TARGET_LINK_OPTIONS(${TARGET} PRIVATE ${ARG_LINK_OPTIONS})
  ENDIF()
  IF(ARG_ADD_TEST)
    ADD_TEST(NAME ${ARG_ADD_TEST} COMMAND ${TARGET})
    SET(ARG_SKIP_INSTALL TRUE)
  ENDIF()
  IF(NOT ARG_SKIP_INSTALL)
    IF(ARG_DESTINATION)
      SET(_dest "${ARG_DESTINATION}")
    ELSE()
      SET(_dest "${INSTALL_BINDIR}")
    ENDIF()
    SET(_comp Router)
    IF(ARG_COMPONENT)
      SET(_comp ${ARG_COMPONENT})
    ENDIF()
    INSTALL(TARGETS ${TARGET} RUNTIME DESTINATION ${_dest} COMPONENT ${_comp})
  ENDIF()
ENDFUNCTION()

