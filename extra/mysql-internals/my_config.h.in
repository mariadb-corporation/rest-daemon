/*
  Slim replacement for the MySQL server's generated my_config.h.

  Only the macros that the mrsd sources (and the vendored server headers in
  extra/mysql-internals) test are provided. Generated by CMake from
  extra/mysql-internals/my_config.h.in.
*/
#ifndef MY_CONFIG_H
#define MY_CONFIG_H

#cmakedefine HAVE_SYS_PRCTL_H 1
#cmakedefine HAVE_STPCPY 1
#cmakedefine HAVE_STPNCPY 1
#cmakedefine HAVE_STRPTIME 1
#cmakedefine HAVE_EPOLL 1
#cmakedefine HAVE_KQUEUE 1
#cmakedefine WORDS_BIGENDIAN 1
#define SIZEOF_CHARP @CMAKE_SIZEOF_VOID_P@
#cmakedefine HAVE_ULONG 1
#cmakedefine HAVE_ABI_CXA_DEMANGLE 1
#cmakedefine HAVE_BUILTIN_UNREACHABLE 1
#cmakedefine HAVE_BUILTIN_EXPECT 1
#cmakedefine HAVE_BUILTIN_STPCPY 1
#cmakedefine HAVE_VALGRIND
#cmakedefine LINUX_ALPINE 1
#cmakedefine HAVE_ASAN
#cmakedefine HAVE_UBSAN
#cmakedefine HAVE_TSAN

#endif  // MY_CONFIG_H
