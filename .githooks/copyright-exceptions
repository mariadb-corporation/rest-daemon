# Files the pre-commit copyright hook must leave alone, for this repository.
#
# One Python regular expression per line, matched with re.match() against the
# repository relative path of every staged file ("^" is implicit, "$" is not).
# Blank lines and lines starting with "#" are ignored; an invalid pattern
# aborts the commit rather than being skipped.
#
# Binary formats that are always excluded (.mwb, .ico, .png, .ttf) are built
# into the hook and need no entry here.

# Vendored third-party code keeps its own license notices.
extra/rapidjson/
extra/libcno/
extra/googletest/
extra/duktape/
# JIT executor library build, copied verbatim from the MySQL Shell sources
