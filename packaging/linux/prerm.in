#!/bin/sh
# Copyright (c) 2026, MariaDB plc. GPL-2.0 (see LICENSE)
#
# deb prerm ($1: remove, upgrade, ...) and rpm %preun ($1: 0 = remove,
# 1 = upgrade): stop and disable the service on removal.
set -e

prog=@MRSD_PROGRAM_NAME@

case "$1" in
  remove|0)
    if [ -d /run/systemd/system ]; then
      systemctl disable --now "$prog" >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
