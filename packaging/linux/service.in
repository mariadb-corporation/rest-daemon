# systemd unit of the deb/rpm packages. Configure first:
#   sudo @MRSD_PROGRAM_NAME@ --setup <user>@<host>:<port> --user @MRSD_PROGRAM_NAME@
#   sudo systemctl enable --now @MRSD_PROGRAM_NAME@

[Unit]
Description=@MYSQL_ROUTER_NAME@
Documentation=file:///usr/share/doc/@MRSD_PROGRAM_NAME@/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=@ROUTER_INSTALL_CONFIGDIR@/@MRSD_PROGRAM_NAME@.conf

[Service]
Type=notify
User=@MRSD_PROGRAM_NAME@
Group=@MRSD_PROGRAM_NAME@
# reads @ROUTER_INSTALL_CONFIGDIR@/@MRSD_PROGRAM_NAME@.conf
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/@MRSD_PROGRAM_NAME@
RuntimeDirectory=@MRSD_PROGRAM_NAME@
LimitNOFILE=10000
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
